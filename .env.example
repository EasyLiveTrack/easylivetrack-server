# ==============================================================================
# EasyLiveTrack Server - Configuration Variables (.env)
# ==============================================================================
# Copy this file to .env before starting with docker-compose:
# cp .env.example .env

# 1. Public Domain Name for your VPS (enables automatic HTTPS via Caddy & Let's Encrypt)
# e.g. gps.yourdomain.com, or your public IP / localhost for local testing
DOMAIN_NAME=gps.yourdomain.com

# 2. Administrator Credentials (used to access the /admin dashboard)
ADMIN_EMAIL=admin@easylivetrack.local
ADMIN_PASSWORD=ChangeThisSuperSecurePassword123!

# 3. Registration Mode:
# - whitelist : (Recommended) Only email addresses approved by the admin can register and send GPS data
# - closed    : No new registrations allowed (only admin can manually create pairing codes/keys)
# - open      : Public registration open to all users
REGISTRATION_MODE=whitelist

# 4. Internal Node.js Server Port
PORT=5055
NODE_ENV=production

# 5. Persistent SQLite database path (mounted inside the Docker volume)
DB_PATH=/data/gpsbeacon.db

# 6. (Optional) Google OAuth 2.0 Client ID if using Google Sign-In with Google Cloud Console
# GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
